APP_NAME="Orchestrator UAT"
APP_ENV=staging
APP_URL=https://ticket-uat.montagnaservizi.com
APP_LOCALE=it
APP_KEY=
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ticket_uat
DB_USERNAME=ticket_uat
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MEM_LIMIT_APP=512m
MEM_LIMIT_WORKER=256m
MEM_LIMIT_DB=384m
MEM_LIMIT_REDIS=128m
MEM_LIMIT_MAILPIT=128m
MEM_LIMIT_DB_LEGACY=384m

# --- db_legacy: sorgente v1 in sola lettura per l'ETL reale ad ogni deploy ---
# (design ETL real data seeding, §4). v1dumps/latest.sql va depositato anche su
# msuat da un umano con bin/load-v1-dump: nessuno script lo fa da solo.
DB_LEGACY_HOST=db_legacy
DB_LEGACY_PORT=5432
DB_LEGACY_DATABASE=orchestrator_legacy
DB_LEGACY_USERNAME=orchestrator_legacy
DB_LEGACY_PASSWORD=

# Percorso sul disco host di msuat con gli allegati v1 reali (bind-montato nel
# container "app" su storage/app/v1-media, vedi docker-compose.uat.yml),
# popolato da un umano con bin/fetch-legacy-media + scp/rsync verso msuat.
LEGACY_MEDIA_HOST_PATH=/opt/mstickets-uat/v1-media
