<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Ogni variabile qui sotto è dichiarata SIA come <env force="true"> SIA
            come <server> (stesso nome/valore) — gotcha ambientale reale
            (Fase 9), verificato empiricamente su questo host:
            - <env force="true"> forza solo getenv()/$_ENV (PhpHandler::handleEnvVariables,
              vendor/phpunit/phpunit/src/TextUI/Configuration/PhpHandler.php):
              senza force, PHPUnit chiama putenv() solo se la variabile non è
              GIÀ presente nel processo reale — e nel container `app` lo È
              sempre (iniettata da `env_file: .env` alla creazione del
              container, per l'intera vita del container).
            - MA Laravel (`Illuminate\Support\Env`) risolve env() leggendo
              $_SERVER, che <env> (anche con force) NON tocca affatto —
              $_SERVER resta popolato dal vero ambiente del processo PHP,
              impostato dal sistema operativo prima ancora che PHPUnit giri.
              Verificato con dump diretto: getenv()/$_ENV correttamente
              'sqlite' con solo force="true", ma $_SERVER['DB_CONNECTION']
              restava 'pgsql' e config('database.default') seguiva
              $_SERVER, non getenv(). Serve quindi ANCHE <server> (elemento
              XML diverso, sempre incondizionato — vedi
              PhpHandler::handleServerVariables, nessun attributo force
              previsto né necessario) per lo stesso identico set di variabili.
            Conseguenza verificata due volte prima di questo fix: (1) i test
            giravano contro il vero Postgres/Redis di sviluppo invece che
            sqlite/array isolati; (2) la cache dei permessi Spatie SCRITTA DAI
            TEST (con dati fittizi di un ruolo/permesso temporaneo) sopravviveva
            nel Redis condiviso con l'app reale (TTL 24h), rompendo il menu di
            navigazione per gli utenti reali ore dopo la fine della suite.
            Con <env force="true"> + <server> combinati, verificato che
            `docker compose exec app vendor/bin/pest` (SENZA alcun `env -u ...`
            manuale) usa correttamente sqlite/array/testing — il workaround
            manuale documentato altrove in questo repo non serve più, ma resta
            comunque valido/innocuo se qualcuno lo usa per abitudine.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="CAI_TAX_CODE_FALLBACK_PATH" value="/nonexistent/cai-tax-code-fallback-testing.json" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="CAI_TAX_CODE_FALLBACK_PATH" value="/nonexistent/cai-tax-code-fallback-testing.json"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
