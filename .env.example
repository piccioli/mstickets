APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Connessione al servizio "db" del docker-compose (Postgres 16, §4.2 del PRD).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=orchestrator
DB_USERNAME=orchestrator
DB_PASSWORD=orchestrator

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Connessione al servizio "redis" del docker-compose (Redis 7, §4.2 del PRD).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Connessione al servizio "mailpit" del docker-compose: SMTP+IMAP locale, UI su http://localhost:8025.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker compose (§4.2 del PRD) ---
# UID/GID dell'utente host: passati come build arg al servizio "app" per evitare
# mismatch di permessi sui volumi bind-mount (nessun chown manuale a runtime).
WWWUSER=1000
WWWGROUP=1000
# Porta su cui il servizio "web" (nginx) espone l'app sull'host.
APP_PORT=8080
# Porte su cui il servizio "mailpit" espone SMTP e la UI web sull'host.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- db_legacy: database di appoggio in sola lettura per il dump v1 (§4.2, §11.1 P2 del PRD) ---
# Avviato SOLO col profilo Compose "etl" (`make etl-up`), mai in esercizio normale.
# L'ETL non scrive mai su questo database: vedi bin/load-v1-dump e php artisan v1:inspect.
DB_LEGACY_HOST=db_legacy
DB_LEGACY_PORT=5432
DB_LEGACY_DATABASE=orchestrator_legacy
DB_LEGACY_USERNAME=orchestrator_legacy
DB_LEGACY_PASSWORD=orchestrator_legacy

# --- Feature flag automazioni schedulate (config/orchestrator.php, §10.1/§10.2 del PRD) ---
# Nessun comando schedulato esiste ancora in questa fase (Fase 0): questi flag sono
# il punto di innesto per quando le fasi successive introdurranno i rispettivi comandi.
# Default di tutti i flag: false. L'abilitazione è una scelta di deploy.
ENABLE_TICKETS_PROGRESS_TO_TODO=false
ENABLE_TICKETS_AUTO_CLOSE_RELEASED=false
ENABLE_TICKETS_CLOSE_SCRUM=false
ENABLE_TICKETS_RESTORE_WAITING=false
ENABLE_TICKETS_WAITING_REMINDERS=false
ENABLE_TICKETS_ARCHIVE_SCRUM=false
ENABLE_MAIL_FETCH_INBOUND=false
ENABLE_MAIL_RETRY_FAILED=false
ENABLE_TIMETRACKING_AGGREGATE=false
ENABLE_REPORTS_MONTHLY=false
ENABLE_MAIL_DIGEST=false
ENABLE_TICKETS_IDLE_DEVELOPER_NOTICE=false

# --- Utente di sistema (config/orchestrator.php, §12 del PRD) ---
# Fallback usato come autore dei log/eventi generati dal sistema (non da un utente
# reale). Creato automaticamente da `php artisan orchestrator:doctor` se manca.
ORCHESTRATOR_SYSTEM_USER_EMAIL=system@orchestrator.local

# --- Allegati sui messaggi del ticket (config/ticketing.php, §9.6/§17.2 del PRD) ---
# Una sola lista di tipi ammessi, condivisa tra UI e (in Fase 3) inbound email.
# Dimensione massima in byte. Disco sempre privato (config/filesystems.php).
TICKET_ATTACHMENTS_DISK=ticket-attachments
TICKET_MAX_FILE_SIZE=10485760
TICKET_ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,json,geojson,txt,csv,zip
TICKET_ALLOWED_DOCUMENT_MIMES="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/json,application/geo+json,text/plain,text/csv,application/zip"
TICKET_ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,bmp,webp,svg,tiff,heic
TICKET_ALLOWED_IMAGE_MIMES="image/jpeg,image/jpg,image/png,image/gif,image/bmp,image/webp,image/svg+xml,image/tiff,image/heic"
TICKET_ALLOWED_AUDIO_TYPES=mp3,m4a,wav,ogg,aac,flac,wma,mp4
TICKET_ALLOWED_AUDIO_MIMES="audio/mpeg,audio/mp4,audio/x-m4a,audio/wav,audio/ogg,audio/aac,audio/flac,audio/x-ms-wma,video/mp4"
