APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Connessione al servizio "db" del docker-compose (Postgres 16, §4.2 del PRD).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=orchestrator
DB_USERNAME=orchestrator
DB_PASSWORD=orchestrator

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Connessione al servizio "redis" del docker-compose (Redis 7, §4.2 del PRD).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Connessione al servizio "mailpit" del docker-compose: SMTP+IMAP locale, UI su http://localhost:8025.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Domini email verso cui è permesso l'invio fuori produzione (§11.8 del PRD, US-217):
# comma-separated, usati sia da `--anonymize` (email fittizie generate su questi domini,
# incluse quelle fisse degli utenti di riferimento del collaudo su oc.test) sia dal guard
# applicativo che blocca l'invio verso qualunque altro indirizzo quando APP_ENV !=
# production (App\Support\Mail\BlockRealRecipientsOutsideProduction).
MAIL_TEST_DOMAINS=test.orchestrator.invalid,oc.test

# --- Pipeline email inbound (config/mail_pipeline.php, §7.3/§7.4 del PRD, US-301) ---
# Casella IMAP da cui `mail:fetch-inbound` (US-302) legge le nuove email, dietro
# App\Domain\Mail\Contracts\InboundMailTransport (implementazione webklex/php-imap).
# In locale punta al servizio "mailpit" (SMTP+IMAP), MAI a una casella reale.
IMAP_HOST=mailpit
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
# Nomi reali delle cartelle sul server IMAP (App\Domain\Mail\Enums\ImapFolderRole).
IMAP_FOLDER_INBOX=INBOX
IMAP_FOLDER_PROCESSED=Processed
IMAP_FOLDER_ERRORS=Errors
IMAP_FOLDER_QUARANTINE=Quarantine
# Numero massimo di messaggi letti da una singola esecuzione di mail:fetch-inbound
# (mai "tutti gli unseen": rischio OOM già noto del v1, §7.3.3 del PRD).
IMAP_FETCH_DEFAULT_LIMIT=50
# Cadenza scheduler, timeout esecuzione, tentativi con backoff sul solo fetch IMAP,
# e durata del lock anti-overlap di mail:fetch-inbound (US-302, §10.1/§10.2 del PRD).
MAIL_FETCH_SCHEDULE_CRON="*/5 * * * *"
MAIL_FETCH_TIMEOUT=300
MAIL_FETCH_TRIES=3
MAIL_FETCH_LOCK_SECONDS=280
# Disco Storage su cui mail:fetch-inbound scrive ogni .eml grezzo prima di qualunque
# parsing (config/filesystems.php, US-302).
MAIL_RAW_STORAGE_DISK=raw-emails
# Soglie anti-loop (§7.3.4 del PRD, US-304): oltre soglia nessun auto-reply parte e
# il mittente va in email_suppressions con reason=loop_protection.
MAIL_RATE_LIMIT_PER_HOUR=3
MAIL_RATE_LIMIT_PER_DAY=10
MAIL_RATE_LIMIT_SUPPRESSION_HOURS=24
# Finestra (giorni) entro cui un thread email è ancora "aperto" per il livello 4
# (euristico, stesso mittente + subject identico) di ResolveEmailThread (§7.3.6,
# US-306): usata solo quando VERP/In-Reply-To/token subject non trovano nulla.
MAIL_THREAD_HEURISTIC_WINDOW_DAYS=30
# Numero di soft bounce consecutivi oltre cui l'indirizzo viene davvero sospeso
# (§7.5.5 del PRD, US-319): sotto soglia email_suppressions.bounce_count viene
# comunque incrementato, ma la riga non blocca ancora l'invio.
MAIL_BOUNCE_SOFT_THRESHOLD=3
# Gruppo staff avvisato di ogni nuovo ticket cliente/mittente sconosciuto (E3/E9,
# US-312): comma-separated. Indirizzo di supporto usato come mittente degli
# auto-reply generati dalla pipeline.
MAIL_STAFF_NOTIFICATION_GROUP=
MAIL_SUPPORT_ADDRESS=
# URL della pagina "gestisci le tue preferenze di notifica" linkata dal footer
# condiviso delle email (§7.5.4, US-310) — Filament\Pages\NotificationPreferences
# (US-605, Fase 6).
MAIL_NOTIFICATION_PREFERENCES_URL=${APP_URL}:8080/admin/notification-preferences
# Base URL della pagina di amministrazione "Quarantena" (US-322, non ancora
# costruita in questa fase) linkata da E9 (UnknownSenderStaffMail, US-312).
# Vuoto finché la pagina non esiste: nessun link mostrato.
MAIL_QUARANTINE_REVIEW_URL=
# Limiti allegati inbound (§7.3.9 del PRD, US-309): configurazione propria e più
# permissiva di TicketAttachmentTypes (US-107), gli allegati inline (loghi/firme)
# sono esclusi per default.
MAIL_ATTACHMENT_MAX_FILE_SIZE=26214400
MAIL_ATTACHMENT_MAX_TOTAL_SIZE=52428800
MAIL_ATTACHMENT_MAX_COUNT=20
MAIL_ATTACHMENT_INCLUDE_INLINE=false
# Reinvio outbound falliti (§7.3.3 del PRD, US-325): limite di default per
# mail:retry-failed e cadenza dello scheduler dietro ENABLE_MAIL_RETRY_FAILED.
MAIL_RETRY_DEFAULT_LIMIT=50
MAIL_RETRY_SCHEDULE_CRON="0 * * * *"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker compose (§4.2 del PRD) ---
# UID/GID dell'utente host: passati come build arg al servizio "app" per evitare
# mismatch di permessi sui volumi bind-mount (nessun chown manuale a runtime).
WWWUSER=1000
WWWGROUP=1000
# Porta su cui il servizio "web" (nginx) espone l'app sull'host.
APP_PORT=8080
# Porte su cui il servizio "mailpit" espone SMTP e la UI web sull'host.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# URL della voce di menu "Mailpit" nel pannello admin (config/mail_pipeline.php,
# §7.7 del PRD, US-324): visibile solo in locale/staging, mai in produzione.
# `${MAILPIT_UI_PORT}` è la sola sintassi di interpolazione che phpdotenv supporta
# davvero (nessun default bash-style `:-`, vedi Dotenv\Loader\Resolver): la
# variabile è già valorizzata sopra in questo stesso file.
MAILPIT_URL=http://localhost:${MAILPIT_UI_PORT}

# --- db_legacy: database di appoggio in sola lettura per il dump v1 (§4.2, §11.1 P2 del PRD) ---
# Avviato SOLO col profilo Compose "etl" (`make etl-up`), mai in esercizio normale.
# L'ETL non scrive mai su questo database: vedi bin/load-v1-dump e php artisan v1:inspect.
DB_LEGACY_HOST=db_legacy
DB_LEGACY_PORT=5432
DB_LEGACY_DATABASE=orchestrator_legacy
DB_LEGACY_USERNAME=orchestrator_legacy
DB_LEGACY_PASSWORD=orchestrator_legacy
# Cartella con i file fisici degli allegati v1 (media.file_name, stage ticket_attachments,
# §11.4/§11.5 del PRD), forniti separatamente dal dump SQL. Vuoto = default storage/app/v1-media.
LEGACY_MEDIA_PATH=

# --- Feature flag automazioni schedulate (config/orchestrator.php, §10.1/§10.2 del PRD) ---
# Nessun comando schedulato esiste ancora in questa fase (Fase 0): questi flag sono
# il punto di innesto per quando le fasi successive introdurranno i rispettivi comandi.
# Default di tutti i flag: false. L'abilitazione è una scelta di deploy.
ENABLE_TICKETS_PROGRESS_TO_TODO=false
ENABLE_TICKETS_AUTO_CLOSE_RELEASED=false
ENABLE_TICKETS_CLOSE_SCRUM=false
ENABLE_TICKETS_RESTORE_WAITING=false
ENABLE_TICKETS_WAITING_REMINDERS=false
ENABLE_TICKETS_ARCHIVE_SCRUM=false
ENABLE_MAIL_FETCH_INBOUND=false
ENABLE_MAIL_RETRY_FAILED=false
ENABLE_TIMETRACKING_AGGREGATE=false
ENABLE_REPORTS_MONTHLY=false
ENABLE_MAIL_DIGEST=false
ENABLE_TICKETS_IDLE_DEVELOPER_NOTICE=false

# --- Utente di sistema (config/orchestrator.php, §12 del PRD) ---
# Fallback usato come autore dei log/eventi generati dal sistema (non da un utente
# reale). Creato automaticamente da `php artisan orchestrator:doctor` se manca.
ORCHESTRATOR_SYSTEM_USER_EMAIL=system@orchestrator.local

# --- Allegati sui messaggi del ticket (config/ticketing.php, §9.6/§17.2 del PRD) ---
# Una sola lista di tipi ammessi, condivisa tra UI e (in Fase 3) inbound email.
# Dimensione massima in byte. Disco sempre privato (config/filesystems.php).
TICKET_ATTACHMENTS_DISK=ticket-attachments
TICKET_MAX_FILE_SIZE=10485760
TICKET_ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,json,geojson,txt,csv,zip
TICKET_ALLOWED_DOCUMENT_MIMES="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/json,application/geo+json,text/plain,text/csv,application/zip"
TICKET_ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,bmp,webp,svg,tiff,heic
TICKET_ALLOWED_IMAGE_MIMES="image/jpeg,image/jpg,image/png,image/gif,image/bmp,image/webp,image/svg+xml,image/tiff,image/heic"
TICKET_ALLOWED_AUDIO_TYPES=mp3,m4a,wav,ogg,aac,flac,wma,mp4
TICKET_ALLOWED_AUDIO_MIMES="audio/mpeg,audio/mp4,audio/x-m4a,audio/wav,audio/ogg,audio/aac,audio/flac,audio/x-ms-wma,video/mp4"
# --- Tracciamento visualizzazioni (config/ticketing.php, §6.2.3 del PRD) ---
TICKET_VIEW_THROTTLE_MINUTES=30

# --- Reminder ticket in attesa E7 (config/ticketing.php, §7.5.2 del PRD, US-316) ---
TICKET_WAITING_REMINDER_THRESHOLD_DAYS=3
TICKET_WAITING_REMINDER_COOLDOWN_DAYS=7
TICKET_WAITING_REMINDER_SCHEDULE_CRON="0 6 * * *"

# --- Calcolo ore lavorate (config/timetracking.php, §6.2.2/§17.1 del PRD) ---
# DECISIONE Q15: una sola politica di calcolo per tickets.worked_minutes e
# ticket_work_logs (nessuna duplicazione delle due politiche divergenti del v1).
TIMETRACKING_WORKDAY_START=9
TIMETRACKING_WORKDAY_END=18
TIMETRACKING_GRANULARITY_MINUTES=10
TIMETRACKING_NON_STATUS_CHANGE_CAP_MINUTES=30

# --- PDF documentazione (config/documentation.php, config/laravel-pdf.php, §6.4.3
# del PRD, US-406) ---
# Driver "chrome" (chrome-php/chrome, Chrome DevTools Protocol in puro PHP): il
# binario Chromium è installato in docker/php/Dockerfile (sviluppo) e
# docker/uat/Dockerfile (produzione), mai Node/Puppeteer. NO_SANDBOX=true è
# necessario in QUALSIASI container (anche non root, es. www-data di
# docker/php/Dockerfile: verificato che il fallimento si presenta comunque) perché
# il sandbox di Chrome richiede di creare user/PID namespace, syscall che il
# runtime container nega di norma indipendentemente dall'utente che esegue il
# processo — non un problema specifico di root.
# CHROME_BINARY vuoto: auto-discovery di chrome-php (trova Chromium in Alpine o
# Google Chrome.app su un Mac di sviluppo). Logo e dati societari nell'intestazione/
# piè di pagina del PDF: percorso file system (mai un URL, il job gira in coda) e
# stringa libera, di default lo stesso logo/indirizzo già usati per le email.
LARAVEL_PDF_DRIVER=chrome
LARAVEL_PDF_CHROME_BINARY=
LARAVEL_PDF_CHROME_NO_SANDBOX=true
PDF_LOGO_PATH=
PDF_FOOTER="Montagna Servizi SCPA — Via Errico Petrella 19, 20124 Milano (MI) · P.IVA 11790660960 · SDI: M5UXCR1 · info@montagnaservizi.com"

# Sigla usata per comporre il nome del file scaricato del PDF di un report di
# attività (§6.5.3 del PRD, US-409), es. "MS-cai-sezione-milano-2026-02.pdf" —
# solo il nome proposto al download, mai il percorso su disco (quello resta
# basato sull'id del report).
PLATFORM_ACRONYM=MS

# --- Generazione mensile dei report attività (config/reporting.php, §6.5.3/§10.2 del PRD, US-410) ---
REPORTS_MONTHLY_SCHEDULE_CRON="0 12 1 * *"
