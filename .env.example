APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Connessione al servizio "db" del docker-compose (Postgres 16, §4.2 del PRD).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=orchestrator
DB_USERNAME=orchestrator
DB_PASSWORD=orchestrator

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Connessione al servizio "redis" del docker-compose (Redis 7, §4.2 del PRD).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Connessione al servizio "mailpit" del docker-compose: SMTP+IMAP locale, UI su http://localhost:8025.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker compose (§4.2 del PRD) ---
# UID/GID dell'utente host: passati come build arg al servizio "app" per evitare
# mismatch di permessi sui volumi bind-mount (nessun chown manuale a runtime).
WWWUSER=1000
WWWGROUP=1000
# Porta su cui il servizio "web" (nginx) espone l'app sull'host.
APP_PORT=8080
# Porte su cui il servizio "mailpit" espone SMTP e la UI web sull'host.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
