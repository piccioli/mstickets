#!/usr/bin/env bash
#
# Ripristina un dump SQL v1 nel servizio db_legacy (database di appoggio
# in sola lettura, §4.2 / §11.1 P2 del PRD). Non scrive mai sul database v1
# sorgente: il dump viene letto da file e ripristinato in un container separato.
#
# Riparte sempre da uno schema pulito (DROP/CREATE prima del restore): idempotente
# per costruzione, richiamabile più volte (stesso dump o uno diverso) senza alcun
# intervento manuale preventivo. Gestisce qui i due motivi documentati in CLAUDE.md
# (sezione ETL) per cui un pg_dump completo non si ripristina mai as-is contro
# postgres:16-alpine vanilla: il ruolo Postgres "orchestrator" (richiesto dagli
# `ALTER ... OWNER TO` del dump) e gli statement PostGIS (l'immagine non ha
# l'estensione: falliscono per costruzione, rumore atteso e innocuo).
#
# Uso: bin/load-v1-dump path/to/dump.sql

set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "Uso: bin/load-v1-dump path/to/dump.sql" >&2
    exit 1
fi

DUMP_PATH="$1"

if [ ! -f "$DUMP_PATH" ]; then
    echo "Errore: file dump non trovato: $DUMP_PATH" >&2
    exit 1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

if [ -f .env ]; then
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
fi

DB_LEGACY_DATABASE="${DB_LEGACY_DATABASE:-orchestrator_legacy}"
DB_LEGACY_USERNAME="${DB_LEGACY_USERNAME:-orchestrator_legacy}"

echo "Avvio del servizio db_legacy (profilo etl)..."
docker compose --profile etl up -d db_legacy

echo "Attendo che db_legacy sia pronto..."
until docker compose --profile etl exec -T db_legacy pg_isready -U "$DB_LEGACY_USERNAME" -d "$DB_LEGACY_DATABASE" >/dev/null 2>&1; do
    sleep 1
done

echo "Reset schema pubblico e schemi PostGIS residui in db_legacy..."
docker compose --profile etl exec -T db_legacy psql -v ON_ERROR_STOP=1 -U "$DB_LEGACY_USERNAME" -d "$DB_LEGACY_DATABASE" <<'SQL'
DROP SCHEMA IF EXISTS public CASCADE;
CREATE SCHEMA public;
DROP SCHEMA IF EXISTS tiger CASCADE;
DROP SCHEMA IF EXISTS tiger_data CASCADE;
DROP SCHEMA IF EXISTS topology CASCADE;
DO $do$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'orchestrator') THEN
        CREATE ROLE orchestrator;
    END IF;
END
$do$;
SQL

echo "Ripristino $DUMP_PATH in db_legacy (sola lettura, database separato da 'db')..."
echo "Nota: gli statement PostGIS del dump (postgis_tiger_geocoder/postgis_topology) falliscono qui per costruzione — postgres:16-alpine non ha l'estensione, rumore atteso e innocuo (CLAUDE.md, sezione ETL)."
docker compose --profile etl exec -T db_legacy psql -U "$DB_LEGACY_USERNAME" -d "$DB_LEGACY_DATABASE" < "$DUMP_PATH"

echo "Verifico che le tabelle applicative principali siano state ripristinate..."
USERS_TABLE_EXISTS="$(docker compose --profile etl exec -T db_legacy psql -v ON_ERROR_STOP=1 -tA -U "$DB_LEGACY_USERNAME" -d "$DB_LEGACY_DATABASE" -c \
    "SELECT 1 FROM information_schema.tables WHERE table_schema = 'public' AND table_name = 'users';")"
if [ "$USERS_TABLE_EXISTS" != "1" ]; then
    echo "Errore: il restore non ha creato la tabella 'users' — dump corrotto o incompatibile." >&2
    exit 1
fi

echo "Dump caricato in db_legacy."
